# ─── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Supabase / PostgreSQL ─────────────────────────────────────
# Get this from: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── JWT Authentication ────────────────────────────────────────
# Generate random strings at: https://randomkeygen.com
JWT_ACCESS_SECRET=replace_with_a_long_random_string_here
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── OpenAI (leave blank for now — AI is mocked) ───────────────
OPENAI_API_KEY=
